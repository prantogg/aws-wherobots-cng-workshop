{
  "mcpServers": {
    "wherobots": {
      "url": "https://api.cloud.wherobots.com/mcp/",
      "type": "http",
      "headers": {
        "x-api-key": "${WHEROBOTS_API_KEY}"
      },
      "autoApprove": [
        "list_catalogs",
        "list_databases",
        "list_tables",
        "describe_table",
        "search_documentation",
        "submit_read_query",
        "get_query_results",
        "cancel_query",
        "list_runtimes",
        "get_runtime"
      ]
    }
  }
}
